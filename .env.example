# Database
DATABASE_URL=postgresql://user:password@localhost:5432/metatracker

# Next-Auth
NEXTAUTH_SECRET=                       # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Encryption (for Meta tokens and Shopify webhook secrets)
ENCRYPTION_KEY=                        # 32 bytes base64: openssl rand -base64 32

# Cron
CRON_SECRET=                           # any random string, used by Railway cron

# App
APP_BASE_URL=http://localhost:3000

# Admin (single-user login)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=                   # bcrypt hash; generate via: npm run hash:password -- "yourpassword"

# Meta Graph API
META_GRAPH_API_VERSION=v25.0
